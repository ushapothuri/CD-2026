Function main
  Assign
    Var(a)
    Const(40,DataType.INT)
  Assign
    Var(b)
    Const(50,DataType.INT)
  Assign
    Var(c)
    Ternary
      RelOp(>)
        Var(a)
        Var(b)
      BinOp(/)
        Cast(double)
          Var(a)
        Var(b)
      BinOp(/)
        Cast(double)
          Var(b)
        Var(a)
  Print
    Var(c)
